# ─── Sito ────────────────────────────────────────────────────────────────
SITE_URL=https://bota.srl
# Dominio del gestionale: admin.bota.srl viene instradato verso /admin
ADMIN_HOST=admin.bota.srl
ADMIN_URL=https://admin.bota.srl
# Stringa casuale lunga (es. `openssl rand -base64 32`): firma token e pseudonimizza gli IP
APP_SECRET=

# ─── Database (Turso / libSQL). Vuoto = file locale .data/bota.db ───────
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# ─── Email: SMTP della casella info@bota.srl (consigliato) ──────────────
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=info@bota.srl
SMTP_PASS=
# ...oppure Resend (alternativa a SMTP, ottimo per la newsletter)
RESEND_API_KEY=
MAIL_FROM="Bota s.r.l. <info@bota.srl>"
# Dove arrivano le richieste di preventivo
LEADS_TO=info@bota.srl

# ─── Foto caricate dal gestionale (Vercel Blob). Vuoto = disco locale ──
BLOB_READ_WRITE_TOKEN=

# ─── Tracciamento (caricati SOLO dopo consenso cookie) ──────────────────
PUBLIC_GA_ID=
PUBLIC_GADS_ID=
PUBLIC_GADS_CONVERSION_LABEL=
PUBLIC_META_PIXEL_ID=
