---
import Icon from './Icon.astro';
import { company } from '../config/site';
---

<aside class="caside" aria-label="Contatti diretti">
  <p class="caside__title">Preferisci parlarne a voce?</p>
  <p class="caside__text">Chiamaci o scrivici su WhatsApp negli orari d’ufficio: ti rispondiamo subito.</p>
  <div class="caside__actions">
    <a class="caside__big" href={company.phone.href} data-track="click_call">
      <Icon name="phone" size={22} /><span><small>Ufficio</small>{company.phone.display}</span>
    </a>
    <a class="caside__big" href={company.mobile.href} data-track="click_call">
      <Icon name="mobile" size={22} /><span><small>Cellulare</small>{company.mobile.display}</span>
    </a>
    <a class="btn btn--wa btn--block" href={company.whatsapp.href} rel="noopener" target="_blank" data-track="click_whatsapp"><Icon name="whatsapp" /> Scrivici su WhatsApp</a>
    <a class="btn btn--outline-light btn--block" href={`mailto:${company.email}`}><Icon name="mail" /> {company.email}</a>
  </div>
  <dl class="caside__hours">
    {company.hours.map((h) => (<div><dt>{h.days}</dt><dd>{h.value}</dd></div>))}
  </dl>
</aside>

<style>
  .caside {
    color: var(--on-dark);
  }
  .caside__title {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 750;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 0.5rem;
  }
  .caside__text {
    color: var(--on-dark-muted);
  }
  .caside__actions {
    display: grid;
    gap: 0.75rem;
    margin: 1.5rem 0;
  }
  .caside__big {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.9rem 1.1rem;
    border-radius: var(--radius-sm);
    background: var(--dark-2);
    border: 1px solid #2a2670;
    color: var(--white) !important;
    font-size: 1.35rem;
    font-weight: 750;
    text-decoration: none;
  }
  .caside__big:hover {
    border-color: var(--accent-on-dark);
  }
  .caside__big :global(svg) {
    color: var(--accent-on-dark);
  }
  .caside__big small {
    display: block;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--on-dark-muted);
    line-height: 1.2;
  }
  .caside__hours {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    font-size: 0.95rem;
  }
  .caside__hours div {
    display: flex;
    justify-content: space-between;
    border-bottom: 1px dashed #2f2b72;
    padding-bottom: 0.45rem;
  }
  .caside__hours dt {
    color: var(--on-dark-muted);
  }
  .caside__hours dd {
    margin: 0;
    font-weight: 650;
  }
</style>
