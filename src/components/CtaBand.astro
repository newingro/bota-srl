---
import Icon from './Icon.astro';
import { company } from '../config/site';
interface Props { title?: string; text?: string }
const {
  title = 'Hai un progetto in mente? Parliamone.',
  text = 'Richiedi un preventivo gratuito: un nostro operatore ti richiamerà al più presto per capire le tue esigenze.',
} = Astro.props;
---

<section class="cta-band">
  <div class="container cta-band__inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="btn-row">
      <a href="/contatti/#preventivo" class="btn btn--light btn--lg">Richiedi preventivo <Icon name="arrow" /></a>
      <a href={company.phone.href} class="btn btn--outline-light btn--lg"><Icon name="phone" /> {company.phone.display}</a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    background: var(--brand-strong);
    color: var(--white);
    padding-block: clamp(2.75rem, 6vw, 4rem);
  }
  .cta-band__inner {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }
  .cta-band h2 {
    margin-bottom: 0.3em;
  }
  .cta-band p {
    margin: 0;
    max-width: 60ch;
    color: #fbe9e0;
  }
  @media (min-width: 960px) {
    .cta-band__inner {
      grid-template-columns: 1fr auto;
      gap: 3rem;
    }
  }
</style>
