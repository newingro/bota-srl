---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import NewsletterForm from './NewsletterForm.astro';
import { company, nav } from '../config/site';
import { mainServices, otherServices, serviceHref } from '../data/services';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer__newsletter">
      <div>
        <p class="footer__nl-title"><Icon name="gift" /> Offerte, coupon e novità</p>
        <p class="footer__nl-text">Iscriviti alla newsletter di Bota: solo comunicazioni utili, niente spam. Puoi cancellarti quando vuoi.</p>
      </div>
      <NewsletterForm source="footer" idPrefix="nl-footer" />
    </div>

    <div class="footer__grid">
      <div class="footer__col footer__brand">
        <Logo variant="light" />
        <p>
          Impresa edile a Campi Bisenzio specializzata in ristrutturazioni chiavi in mano ed efficientamento energetico. Da oltre {company.yearsOfExperience} anni a Firenze e provincia.
        </p>
        {
          company.social.facebook && (
            <a class="footer__social" href={company.social.facebook} rel="noopener" target="_blank">
              <Icon name="facebook" /> Seguici su Facebook
            </a>
          )
        }
      </div>

      <div class="footer__col">
        <p class="footer__title">Contatti</p>
        <ul class="footer__list">
          <li><Icon name="pin" size={18} /><span>{company.address.street}<br />{company.address.postalCode} {company.address.city} ({company.address.province})</span></li>
          <li><Icon name="phone" size={18} /><a href={company.phone.href}>{company.phone.display}</a></li>
          <li><Icon name="mobile" size={18} /><a href={company.mobile.href}>{company.mobile.display}</a></li>
          <li><Icon name="mail" size={18} /><a href={`mailto:${company.email}`}>{company.email}</a></li>
        </ul>
      </div>

      <div class="footer__col">
        <p class="footer__title">Orari ufficio</p>
        <dl class="footer__hours">
          {company.hours.map((h) => (<div><dt>{h.days}</dt><dd>{h.value}</dd></div>))}
        </dl>
      </div>

      <div class="footer__col">
        <p class="footer__title">Servizi</p>
        <ul class="footer__links">
          {[...mainServices, ...otherServices.slice(1)].map((s) => (<li><a href={serviceHref(s)}>{s.title}</a></li>))}
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p>© {year} {company.legalName} · P.IVA / C.F. {company.vat} · {company.address.street}, {company.address.postalCode} {company.address.city} ({company.address.province})</p>
      <ul class="footer__legal">
        {nav.slice(1).map((n) => (<li><a href={n.href}>{n.label}</a></li>))}
        <li><a href="/privacy-policy/">Privacy policy</a></li>
        <li><a href="/cookie-policy/">Cookie policy</a></li>
        <li><button type="button" class="linklike" data-cookie-preferences>Preferenze cookie</button></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--dark);
    color: var(--on-dark-muted);
    font-size: 0.95rem;
    padding-top: clamp(3rem, 6vw, 4.5rem);
  }
  .site-footer a {
    color: var(--white);
    text-decoration: none;
  }
  .site-footer a:hover {
    color: var(--accent-on-dark);
    text-decoration: underline;
  }
  .footer__newsletter {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
    border: 1px solid #36424b;
    border-radius: var(--radius);
    background: var(--dark-2);
  }
  .footer__nl-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.3rem;
    color: var(--white);
    font-size: 1.35rem;
    font-weight: 750;
  }
  .footer__nl-title :global(svg) {
    color: var(--accent-on-dark);
  }
  .footer__nl-text {
    margin: 0;
  }
  @media (min-width: 900px) {
    .footer__newsletter {
      grid-template-columns: 1fr 1.15fr;
      align-items: center;
      gap: 2.5rem;
    }
  }
  .footer__grid {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 640px) {
    .footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .footer__grid {
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
      gap: 2.5rem;
    }
  }
  .footer__brand p {
    margin: 1rem 0;
    max-width: 36ch;
  }
  .footer__social {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    font-weight: 600;
  }
  .footer__title {
    margin: 0 0 1rem;
    color: var(--white);
    font-weight: 750;
    font-size: 1rem;
    letter-spacing: 0.02em;
  }
  .footer__list,
  .footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }
  .footer__list li {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 0.65rem;
    align-items: start;
  }
  .footer__list :global(svg) {
    margin-top: 0.2rem;
    color: var(--accent-on-dark);
  }
  .footer__hours {
    margin: 0;
    display: grid;
    gap: 0.55rem;
  }
  .footer__hours div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px dashed #3b4750;
    padding-bottom: 0.45rem;
  }
  .footer__hours dt {
    font-weight: 500;
  }
  .footer__hours dd {
    margin: 0;
    color: var(--white);
    font-weight: 600;
  }
  .footer__bottom {
    display: grid;
    gap: 1rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-block: 1.5rem 2rem;
    border-top: 1px solid #36424b;
    font-size: 0.85rem;
  }
  .footer__bottom p {
    margin: 0;
  }
  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer__legal a,
  .linklike {
    display: inline-block;
    padding-block: 0.35rem;
  }
  .linklike {
    background: none;
    border: 0;
    padding-inline: 0;
    color: var(--white);
    font: inherit;
    cursor: pointer;
  }
  .linklike:hover {
    color: var(--accent-on-dark);
    text-decoration: underline;
  }
  @media (max-width: 1023px) {
    .site-footer {
      padding-bottom: 72px;
    }
  }
</style>
