---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { company, nav } from '../config/site';

const current = Astro.url.pathname.replace(/\/?$/, '/');
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---

<header class="site-header">
  <div class="topbar">
    <div class="container topbar__inner">
      <span class="topbar__item"><Icon name="pin" size={16} /> Campi Bisenzio (FI) · Firenze e provincia</span>
      <span class="topbar__item topbar__hours"><Icon name="clock" size={16} /> Lun–Ven 8–18 · Sab 8–17</span>
      <a class="topbar__item" href={`mailto:${company.email}`}><Icon name="mail" size={16} /> {company.email}</a>
    </div>
  </div>
  <div class="container header__inner">
    <a href="/" class="brand">
      <Logo />
    </a>

    <nav class="nav" aria-label="Menu principale">
      <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="menu-principale">
        <span class="nav__toggle-open"><Icon name="menu" /></span>
        <span class="nav__toggle-close"><Icon name="close" /></span>
        <span class="sr-only">Menu</span>
      </button>
      <ul id="menu-principale" class="nav__list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="nav__link" aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="nav__mobile-cta">
          <a href="/contatti/#preventivo" class="btn btn--block">Richiedi preventivo gratuito</a>
          <a href={company.phone.href} class="btn btn--ghost btn--block"><Icon name="phone" /> {company.phone.display}</a>
        </li>
      </ul>
    </nav>

    <div class="header__cta">
      <a class="header__phone" href={company.phone.href}>
        <Icon name="phone" size={20} />
        <span><small>Chiamaci</small>{company.phone.display}</span>
      </a>
      <a href="/contatti/#preventivo" class="btn">Preventivo gratuito</a>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav__toggle');
  const list = document.getElementById('menu-principale');
  if (toggle && list) {
    const close = () => {
      toggle.setAttribute('aria-expanded', 'false');
      document.documentElement.classList.remove('menu-open');
    };
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      document.documentElement.classList.toggle('menu-open', !open);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        close();
        toggle.focus();
      }
    });
    list.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(255 255 255 / 97%);
    border-bottom: 1px solid var(--line);
  }
  .topbar {
    display: none;
    background: var(--dark);
    color: var(--on-dark-muted);
    font-size: 0.85rem;
  }
  .topbar__inner {
    display: flex;
    gap: 1.75rem;
    justify-content: flex-end;
    padding-block: 0.4rem;
  }
  .topbar__item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: inherit;
    text-decoration: none;
  }
  a.topbar__item:hover {
    color: var(--white);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--header-h);
  }
  .brand {
    display: inline-flex;
    flex: none;
  }
  .brand :global(svg) {
    width: 150px;
    height: auto;
  }
  .nav__toggle {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1.5px solid var(--line);
    border-radius: 12px;
    background: var(--white);
    color: var(--ink);
    cursor: pointer;
  }
  .nav__toggle-close {
    display: none;
  }
  .nav__toggle[aria-expanded='true'] .nav__toggle-open {
    display: none;
  }
  .nav__toggle[aria-expanded='true'] .nav__toggle-close {
    display: block;
  }
  .nav__list {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav__toggle[aria-expanded='true'] + .nav__list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    position: fixed;
    inset: var(--header-h) 0 0 0;
    padding: 1.25rem var(--gutter) 2rem;
    background: var(--white);
    overflow-y: auto;
  }
  .nav__link {
    display: block;
    padding: 0.85rem 0.25rem;
    color: var(--ink);
    font-size: 1.25rem;
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  .nav__link[aria-current='page'] {
    color: var(--brand-strong);
  }
  .nav__mobile-cta {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }
  .header__cta {
    display: none;
  }
  :global(html.menu-open) {
    overflow: hidden;
  }

  @media (min-width: 1024px) {
    .topbar {
      display: block;
    }
    .brand :global(svg) {
      width: 172px;
    }
    .nav__toggle {
      display: none;
    }
    .nav__list,
    .nav__toggle[aria-expanded='true'] + .nav__list {
      display: flex;
      flex-direction: row;
      position: static;
      padding: 0;
      gap: 0.25rem;
      background: none;
    }
    .nav__link {
      position: relative;
      padding: 0.5rem 0.85rem;
      font-size: 1rem;
      font-weight: 600;
      border: 0;
    }
    .nav__link::after {
      content: '';
      position: absolute;
      left: 0.85rem;
      right: 0.85rem;
      bottom: 0.2rem;
      height: 2px;
      background: var(--brand);
      transform: scaleX(0);
      transition: transform 0.2s ease;
    }
    .nav__link:hover::after,
    .nav__link[aria-current='page']::after {
      transform: scaleX(1);
    }
    .nav__mobile-cta {
      display: none;
    }
    .header__cta {
      display: flex;
      align-items: center;
      gap: 1.25rem;
    }
    .header__phone {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      color: var(--ink);
      font-weight: 700;
      text-decoration: none;
      white-space: nowrap;
    }
    .header__phone :global(svg) {
      color: var(--brand-strong);
    }
    .header__phone small {
      display: block;
      font-size: 0.75rem;
      font-weight: 500;
      color: var(--muted);
      line-height: 1.1;
    }
  }
  @media (min-width: 1024px) and (max-width: 1180px) {
    .header__phone {
      display: none;
    }
  }
</style>
