---
/**
 * Logo ufficiale Bota s.r.l. (file in public/brand/, sorgente in src/assets/brand/).
 * variant="light": su sfondi scuri il logo viene mostrato su una targa bianca.
 */
interface Props {
  variant?: 'dark' | 'light';
  class?: string;
  width?: number;
  eager?: boolean;
}
const { variant = 'dark', class: cls, width = 200, eager = true } = Astro.props;
const height = Math.round((width * 134) / 400);
---

<span class:list={['logo', { 'logo--plate': variant === 'light' }, cls]}>
  <img
    src="/brand/bota-logo-400.webp"
    srcset="/brand/bota-logo-200.webp 200w, /brand/bota-logo-400.webp 400w"
    sizes={`${width}px`}
    width={width}
    height={height}
    alt="Bota s.r.l. Impresa edile"
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
  />
</span>

<style>
  .logo {
    display: inline-flex;
    line-height: 0;
  }
  .logo img {
    height: auto;
    max-width: 100%;
  }
  .logo--plate {
    padding: 0.5rem 0.75rem;
    background: #fff;
    border-radius: 10px;
  }
</style>
