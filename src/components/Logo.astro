---
/**
 * Logo provvisorio (wordmark SVG inline). Sostituire con il logo ufficiale:
 * basta rimpiazzare il contenuto dell'<svg> mantenendo viewBox e aria-label.
 */
interface Props { variant?: 'dark' | 'light'; class?: string; }
const { variant = 'dark', class: cls } = Astro.props;
const text = variant === 'light' ? '#ffffff' : '#15191d';
const sub = variant === 'light' ? '#c9d0d6' : '#5c656e';
---
<svg class={cls} xmlns="http://www.w3.org/2000/svg" viewBox="0 0 172 44" width="172" height="44" role="img" aria-label="Bota s.r.l. Impresa edile – Home">
  <rect x="0" y="2" width="40" height="40" rx="9" fill="#b4441a"/>
  <path d="M8 22.5 20 12l12 10.5" fill="none" stroke="#fff" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/>
  <rect x="11" y="25" width="8" height="5" rx="1" fill="#fff"/><rect x="21" y="25" width="8" height="5" rx="1" fill="#fff"/>
  <rect x="11" y="32" width="18" height="4" rx="1" fill="#fff" opacity=".75"/>
  <text x="50" y="29" font-family="var(--font-archivo), Arial, sans-serif" font-size="26" font-weight="800" letter-spacing="-0.5" fill={text}>BOTA<tspan dx="5" font-size="13" font-weight="600" letter-spacing="0" fill={sub}>s.r.l.</tspan></text>
  <text x="50" y="41" font-family="var(--font-archivo), Arial, sans-serif" font-size="8.6" font-weight="700" letter-spacing="1.9" fill={sub}>IMPRESA EDILE</text>
</svg>
