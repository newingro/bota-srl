---
import QuoteForm from './QuoteForm.astro';
import ContactAside from './ContactAside.astro';
interface Props { preselect?: string; title?: string; eyebrow?: string; heading?: string }
const { preselect, title, eyebrow = 'Preventivo gratuito', heading = 'Raccontaci il tuo progetto' } = Astro.props;
---

<section class="section section--dark qs" aria-labelledby="qs-heading">
  <div class="container qs__grid">
    <div class="qs__intro">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="qs-heading" class="qs__heading">{heading}</h2>
      <ContactAside />
    </div>
    <QuoteForm preselect={preselect} title={title} />
  </div>
</section>

<style>
  .qs__grid {
    display: grid;
    gap: 2.5rem;
  }
  .qs__heading {
    margin-bottom: 0.75em;
  }
  .qs__intro :global(.caside__title) {
    font-size: 1.25rem;
  }
  @media (min-width: 1024px) {
    .qs__grid {
      grid-template-columns: 0.85fr 1.15fr;
      gap: 4rem;
      align-items: start;
    }
    .qs__intro {
      position: sticky;
      top: calc(var(--header-h) + 3rem);
    }
  }
</style>
