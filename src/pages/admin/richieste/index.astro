---
import Admin from '../../../layouts/Admin.astro';
import Icon from '../../../components/Icon.astro';
import { all } from '../../../lib/db';
import { ahref, leadStatuses, statusLabel } from '../../../lib/admin';
import { formatDate } from '../../../lib/format';

export const prerender = false;

const stato = Astro.url.searchParams.get('stato') || '';
const q = (Astro.url.searchParams.get('q') || '').trim();
const where: string[] = [];
const args: string[] = [];
if (leadStatuses.some((s) => s.value === stato)) {
  where.push('status = ?');
  args.push(stato);
}
if (q) {
  where.push('(name LIKE ? OR email LIKE ? OR phone LIKE ? OR comune LIKE ?)');
  args.push(...Array(4).fill(`%${q}%`));
}
const leads = await all(`SELECT * FROM leads ${where.length ? 'WHERE ' + where.join(' AND ') : ''} ORDER BY created_at DESC LIMIT 300`, args);
const counts = Object.fromEntries((await all<{ status: string; n: number }>('SELECT status, COUNT(*) AS n FROM leads GROUP BY status')).map((r) => [r.status, Number(r.n)]));
const total = Object.values(counts).reduce((a, b) => a + b, 0);
---

<Admin title="Richieste preventivo" section="richieste">
  <a slot="actions" class="btn btn--sm btn--ghost" href={ahref(Astro, '/richieste/export.csv')}><Icon name="download" size={18} /> Esporta CSV</a>
  <div class="toolbar">
    <nav class="tabs" aria-label="Filtra per stato">
      <a href={ahref(Astro, '/richieste')} aria-current={!stato ? 'page' : undefined}>Tutte ({total})</a>
      {leadStatuses.map((s) => (<a href={ahref(Astro, `/richieste?stato=${s.value}`)} aria-current={stato === s.value ? 'page' : undefined}>{s.label} ({counts[s.value] ?? 0})</a>))}
    </nav>
    <form method="get" class="toolbar" role="search" style="margin:0 0 0 auto">
      {stato && <input type="hidden" name="stato" value={stato} />}
      <label class="sr-only" for="q">Cerca</label>
      <input class="input" id="q" name="q" type="search" placeholder="Cerca nome, email, telefono…" value={q} />
      <button class="btn btn--sm" type="submit">Cerca</button>
    </form>
  </div>

  <section class="panel">
    {
      leads.length ? (
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th>Data</th><th>Cliente</th><th>Contatti</th><th>Intervento</th><th>Comune</th><th>Origine</th><th>Stato</th></tr></thead>
            <tbody>
              {leads.map((l) => {
                const s = statusLabel(String(l.status));
                return (
                  <tr>
                    <td class="nowrap">{formatDate(String(l.created_at), true)}</td>
                    <td><a href={ahref(Astro, `/richieste/${l.id}`)}>{l.name}</a>{Number(l.newsletter_optin) ? <span class="pill pill--info" title="Ha chiesto la newsletter"> NL</span> : null}</td>
                    <td class="nowrap"><a href={`tel:${String(l.phone).replace(/[^\d+]/g, '')}`}>{l.phone}</a><br /><span class="muted">{l.email}</span></td>
                    <td>{l.service}</td>
                    <td>{l.comune || '–'}</td>
                    <td>{l.gclid ? 'Google Ads' : l.utm_source || 'Sito'}</td>
                    <td><span class={`pill pill--${s.tone}`}>{s.label}</span></td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="empty-state">Nessuna richiesta trovata.</p>
      )
    }
  </section>
</Admin>
